{
  "platforms": {
    "amazon": {
      "output": "amazon.xml.gz",
      "explicit_xmltv_ids": [],
      "rules": [
        {
          "name_regex": [
            "\\bAmazon\\b",
            "\\bFreevee\\b",
            "\\bPrime Video\\b"
          ]
        }
      ]
    },
    "pluto": {
      "output": "pluto.xml.gz",
      "rules": [
        {
          "site": "pluto.tv",
          "source_file_contains": "pluto.tv_de.channels.xml"
        }
      ]
    },
    "samsung": {
      "output": "samsung.xml.gz",
      "rules": [
        {
          "site": "i.mjh.nz",
          "site_id_prefix": [
            "SamsungTVPlus/de#",
            "SamsungTVPlus/at#",
            "SamsungTVPlus/ch#"
          ]
        }
      ]
    }
  }
}
